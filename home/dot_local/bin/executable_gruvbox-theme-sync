#!/usr/bin/env bash
# Keep the Gruvbox look in step with GNOME's Dark Style toggle
# (org.gnome.desktop.interface color-scheme). Runs as the systemd user
# service gruvbox-theme-sync; `gruvbox-theme-sync --once` applies and exits.
#
#   prefer-dark          -> Gruvbox-Orange-Dark  + Gruvbox-Dark icons
#   default/prefer-light -> Gruvbox-Orange-Daylight + Gruvbox-Light icons
#
# Only machine-generated files are written (gruvbox-current.*, ignored by
# chezmoi), so tracked dotfiles never drift. Kitty needs nothing here: it
# reads ~/.config/kitty/{light,dark}-theme.auto.conf on its own.
set -euo pipefail

GTK4_CURRENT="$HOME/.config/gtk-4.0/gruvbox-current.css"
ALACRITTY_DIR="$HOME/.config/alacritty"
CLAUDE_SETTINGS="$HOME/.claude/settings.json"

# Write via rename so watchers (Alacritty live reload) see one complete file.
replace() {
  local dest=$1 tmp
  tmp=$(mktemp "$dest.XXXXXX")
  cat > "$tmp"
  mv "$tmp" "$dest"
}

apply() {
  local scheme mode Mode
  scheme=$(gsettings get org.gnome.desktop.interface color-scheme | tr -d "'")
  if [[ $scheme == prefer-dark ]]; then mode=dark Mode=Dark; else mode=light Mode=Light; fi
  # Light mode uses the high-contrast Daylight build (derived from Light by
  # run_onchange_after_tune-gruvbox-daylight.sh); fall back if it is missing.
  local theme="Gruvbox-Orange-$Mode"
  [[ $mode == light && -d $HOME/.themes/Gruvbox-Orange-Daylight ]] && theme=Gruvbox-Orange-Daylight

  gsettings set org.gnome.desktop.interface gtk-theme "$theme"
  gsettings set org.gnome.desktop.interface icon-theme "Gruvbox-$Mode"
  dconf write /org/gnome/shell/extensions/user-theme/name "'$theme'"

  # GTK4/libadwaita; running GTK4 apps pick this up on restart.
  echo "@import url(\"file://$HOME/.themes/$theme/gtk-4.0/gtk.css\");" | replace "$GTK4_CURRENT"

  # Light mode uses the high-contrast "daylight" palette; stock gruvbox-light
  # washes out in a bright office (accents at 2.2-3.7:1 contrast).
  local palette=$mode
  [[ $mode == light ]] && palette=daylight
  replace "$ALACRITTY_DIR/gruvbox-current.toml" < "$ALACRITTY_DIR/gruvbox-$palette.toml"

  # Zellij: running sessions don't re-detect the terminal's colours, so switch
  # them explicitly (theme_light/theme_dark in config.kdl cover new sessions).
  if command -v zellij >/dev/null; then
    local session
    while read -r session; do
      zellij -s "$session" action "set-$mode-theme" 2>/dev/null || true
    done < <(zellij list-sessions --short --no-formatting 2>/dev/null || true)
  fi

  # Claude Code's own palette (colour-blind-friendly variant); its dark
  # colours are unreadable on the light terminal background. Running
  # sessions need a restart.
  if [[ -f $CLAUDE_SETTINGS ]] && command -v jq >/dev/null; then
    local settings
    settings=$(jq --arg t "$mode-daltonized" '.theme = $t' "$CLAUDE_SETTINGS") &&
      printf '%s\n' "$settings" | replace "$CLAUDE_SETTINGS"
  fi

  echo "color-scheme=$scheme -> $theme"
}

apply
[[ ${1:-} == --once ]] && exit 0

gsettings monitor org.gnome.desktop.interface color-scheme | while read -r _; do
  apply
done
